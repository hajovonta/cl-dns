<test:cl-dns:dns-error-condition> <rdf:type> <test> .
<cl-dns:dns-error> <cg:testedBy> <test:cl-dns:dns-error-condition> .
<test:cl-dns:dns-error-condition> <cg:sourceText> "(let ((c (make-condition 'cl-dns:dns-error :message \"test\" :rcode 5)))\n  (is (string= \"test\" (cl-dns::dns-error-message c)))\n  (is (= 5 (cl-dns::dns-error-rcode c))))" .
<test:cl-dns:dns-error-condition> <cg:inSuite> <protocol> .
<test:cl-dns:dns-timeout-condition> <rdf:type> <test> .
<cl-dns:dns-timeout> <cg:testedBy> <test:cl-dns:dns-timeout-condition> .
<test:cl-dns:dns-timeout-condition> <cg:sourceText> "(let ((c (make-condition 'cl-dns:dns-timeout :nameserver \"1.1.1.1\")))\n  (is (string= \"1.1.1.1\" (cl-dns::dns-timeout-nameserver c)))\n  (is (search \"timed out\" (format nil \"~A\" c))))" .
<test:cl-dns:dns-timeout-condition> <cg:inSuite> <protocol> .
<test:cl-dns:dns-nxdomain-condition> <rdf:type> <test> .
<cl-dns:dns-nxdomain> <cg:testedBy> <test:cl-dns:dns-nxdomain-condition> .
<test:cl-dns:dns-nxdomain-condition> <cg:sourceText> "(let ((c (make-condition 'cl-dns:dns-nxdomain :name \"no.exist\")))\n  (is (string= \"no.exist\" (cl-dns::dns-nxdomain-name c)))\n  (is (= 3 (cl-dns::dns-error-rcode c))))" .
<test:cl-dns:dns-nxdomain-condition> <cg:inSuite> <protocol> .
<test:cl-dns:udp-transport-slots> <rdf:type> <test> .
<cl-dns:udp-transport> <cg:testedBy> <test:cl-dns:udp-transport-slots> .
<test:cl-dns:udp-transport-slots> <cg:sourceText> "(let ((tr (make-instance 'cl-dns:udp-transport :host \"8.8.8.8\" :port 53)))\n  (is (string= \"8.8.8.8\" (cl-dns::transport-host tr)))\n  (is (= 53 (cl-dns::transport-port tr))))" .
<test:cl-dns:udp-transport-slots> <cg:inSuite> <protocol> .
<test:cl-dns:tls-transport-defaults> <rdf:type> <test> .
