<test:cl-dns:encode-name-compressed-dedup> <rdf:type> <test> .
<cl-dns:encode-name-compressed> <cg:testedBy> <test:cl-dns:encode-name-compressed-dedup> .
<test:cl-dns:encode-name-compressed-dedup> <cg:sourceText> "(let ((buf (make-array 128 :element-type '(unsigned-byte 8) :initial-element 0))\n      (ct (make-hash-table :test 'equal)))\n  (let* ((off1 (cl-dns::encode-name-compressed \"foo.example.com\" buf 0 ct))\n         (off2 (cl-dns::encode-name-compressed \"bar.example.com\" buf off1 ct)))\n    ;; Second encode should use compression pointer for \"example.com\"\n    (is (< off2 (+ off1 17)))\n    ;; Verify we can decode both\n    (is (string= \"foo.example.com\" (cl-dns::decode-name buf 0)))\n    (is (string= \"bar.example.com\" (cl-dns::decode-name buf off1)))))" .
<test:cl-dns:encode-name-compressed-dedup> <cg:inSuite> <protocol> .
<test:cl-dns:make-opt-rr-with-do-bit> <rdf:type> <test> .
<cl-dns:make-opt-rr> <cg:testedBy> <test:cl-dns:make-opt-rr-with-do-bit> .
<test:cl-dns:make-opt-rr-with-do-bit> <cg:sourceText> "(let ((opt (cl-dns:make-opt-rr :udp-size 4096 :do-bit t)))\n  (is (eq :opt (cl-dns::rr-type opt)))\n  (is (= 4096 (cl-dns::rr-class opt)))\n  (is (= #x8000 (cl-dns::rr-ttl opt))))" .
<test:cl-dns:make-opt-rr-with-do-bit> <cg:inSuite> <protocol> .
