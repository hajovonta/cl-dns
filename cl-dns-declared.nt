<cl-dns:encode-message> <cg:calls> <cl-dns:encode-rdata> .
<cl-dns:decode-message> <cg:sourceText> "(defun decode-message (bytes)\n  \"Decode a DNS message from a byte vector received from the wire.\"\n  (let* ((buf (coerce bytes '(simple-array (unsigned-byte 8) (*))))\n         (hdr (make-instance 'dns-header\n                :id (logior (ash (aref buf 0) 8) (aref buf 1))\n                :qr (ash (logand (aref buf 2) #x80) -7)\n                :opcode (ash (logand (aref buf 2) #x78) -3)\n                :aa (ash (logand (aref buf 2) #x04) -2)\n                :tc (ash (logand (aref buf 2) #x02) -1)\n                :rd (logand (aref buf 2) #x01)\n                :ra (ash (logand (aref buf 3) #x80) -7)\n                :rcode (logand (aref buf 3) #x0F)\n                :qdcount (logior (ash (aref buf 4) 8) (aref buf 5))\n                :ancount (logior (ash (aref buf 6) 8) (aref buf 7))\n                :nscount (logior (ash (aref buf 8) 8) (aref buf 9))\n                :arcount (logior (ash (aref buf 10) 8) (aref buf 11))))\n         (offset 12)\n         (questions nil)\n         (type-alist (mapcar (lambda (p) (cons (cdr p) (car p))) *record-types*))\n         (class-alist (mapcar (lambda (p) (cons (cdr p) (car p))) *class-codes*)))\n    ;; Decode questions\n    (dotimes (_ (header-qdcount hdr))\n      (multiple-value-bind (name new-off) (decode-name buf offset)\n        (setf offset new-off)\n        (let ((qt (logior (ash (aref buf offset) 8) (aref buf (1+ offset))))\n              (qc (logior (ash (aref buf (+ offset 2)) 8) (aref buf (+ offset 3)))))\n          (incf offset 4)\n          (push (make-instance 'dns-question\n                  :qname name\n                  :qtype (or (cdr (assoc qt type-alist)) qt)\n                  :qclass (or (cdr (assoc qc class-alist)) qc))\n                questions))))\n    ;; Decode RR sections\n    (flet ((decode-rrs (count)\n             (let ((rrs nil))\n               (dotimes (_ count (nreverse rrs))\n                 (multiple-value-bind (name new-off) (decode-name buf offset)\n                   (setf offset new-off)\n                   (let* ((rtype-num (logior (ash (aref buf offset) 8) (aref buf (1+ offset))))\n                          (rclass-num (logior (ash (aref buf (+ offset 2)) 8) (aref buf (+ offset 3))))\n                          (ttl (logior (ash (aref buf (+ offset 4)) 24) (ash (aref buf (+ offset 5)) 16)\n                                       (ash (aref buf (+ offset 6)) 8) (aref buf (+ offset 7))))\n                          (rdlen (logior (ash (aref buf (+ offset 8)) 8) (aref buf (+ offset 9))))\n                          (rtype (or (cdr (assoc rtype-num type-alist)) rtype-num))\n                          (rclass (or (cdr (assoc rclass-num class-alist)) rclass-num)))\n                     (incf offset 10)\n                     (push (make-instance 'dns-rr\n                             :name name :type rtype :class rclass :ttl ttl\n                             :rdata (decode-rdata rtype buf offset rdlen))\n                           rrs)\n                     (incf offset rdlen)))))))\n      (make-instance 'dns-message\n        :header hdr\n        :questions (nreverse questions)\n        :answers (decode-rrs (header-ancount hdr))\n        :authority (decode-rrs (header-nscount hdr))\n        :additional (decode-rrs (header-arcount hdr))))))" .
<cl-dns:decode-message> <cg:calls> <cl-dns:decode-name> .
